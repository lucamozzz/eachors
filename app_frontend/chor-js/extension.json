{
  "name": "Msg",
  "uri": "http://example.com/msg",
  "prefix": "msg",
  "xml": { "tagAlias": "lowerCase" },
  "types": [
    {
      "name": "TypedMessage",
      "extends": [ "bpmn:Message" ],
      "properties": [
        { "name": "messageType", "isAttr": true, "type": "String" },
        { "name": "messageDestination", "isAttr": true, "type": "String" },
        { "name": "guard", "isAttr": true, "type": "String" },
        { "name": "assignments", "type": "Assignment", "isMany": true, "xml": { "serialize": "element" } }
      ]
    },
    {
      "name": "GuardedSequenceFlow",
      "extends": [ "bpmn:SequenceFlow" ],
      "properties": [
        { "name": "guard", "isAttr": true, "type": "String" }
      ]
    },
    {
      "name": "Assignment",
      "superClass": [ "Element" ],
      "properties": [
        { "name": "attribute", "isAttr": true, "type": "String" },
        { "name": "value", "isAttr": true, "type": "String" }
      ]
    },
    {
  "name": "ParticipantWithPlace",
  "extends": [ "bpmn:Participant" ],
  "properties": [
    { "name": "participantPlace", "isAttr": true, "type": "String" }
  ]
} 
  ]
}